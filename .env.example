# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat IDs
SOURCE_CHAT_ID=-1001234567890
TARGET_CHANNEL_ID=-1001234567891

# OpenRouter Configuration (free tier for some models)
